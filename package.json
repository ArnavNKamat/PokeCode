{
  "name": "poke-code",
  "displayName": "PokeCode",
  "description": "A Pokémon companion inside VS Code",
  "publisher": "ArnavNKamat",
  "version": "1.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArnavNKamat/PokeCode"
  },
  "homepage": "https://github.com/ArnavNKamat/PokeCode",
  "bugs": {
    "url": "https://github.com/ArnavNKamat/PokeCode/issues"
  },
  "icon": "media/pokeball.png",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "poke-code.open",
        "title": "PokeCode: Open"
      },
      {
        "command": "poke-code.resetData",
        "title": "PokeCode: Reset Data"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pokeCode",
          "title": "PokeCode",
          "icon": "media/pokeball.svg" 
        }
      ]
    },
    "views": {
      "pokeCode": [
        {
          "type": "webview",
          "id": "pokeCode.view",
          "name": "PokeCode",
          "icon": "media/pokeball.png"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}